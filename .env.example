# Copy this file to .env and fill in your own key. Never upload .env to GitHub.
# LLM_PROVIDER: groq | none (offline test, no model called)
LLM_PROVIDER=groq

# Groq. Key from console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# SEARCH_MODE: bm25 (default, measured best) | hybrid (adds e5 vectors from ChromaDB)
SEARCH_MODE=bm25
LLM_TIMEOUT=30
EVAL_PAUSE=20
